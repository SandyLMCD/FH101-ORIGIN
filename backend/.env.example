# Server
PORT=4000
# Comma-separated list of allowed browser origins (Vite dev server by default)
CORS_ORIGIN=http://localhost:5173
# Simulated OCR duration in seconds (replace with Scribe.js pipeline later)
OCR_SECONDS=2.5

# Supabase (not used by the in-memory prototype store yet — reserved for the real data layer)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Drive backup (institutional/project account; see Chapter 3)
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
